default_platform(:ios)

APP_IDENTIFIER = "com.lightwave.blahblah".freeze
XCODEPROJ = "ios/BlahBlah.xcodeproj".freeze
WORKSPACE = "ios/BlahBlah.xcworkspace".freeze
SCHEME = "BlahBlah".freeze

platform :ios do
  desc "Build the iOS app and upload it to TestFlight (App Store Connect API key + manual signing)"
  lane :beta do
    key_id = ENV.fetch("APPSTORE_API_KEY_ID")
    issuer_id = ENV.fetch("APPSTORE_ISSUER_ID")
    key_path = ENV.fetch("ASC_API_KEY_PATH") # .p8 written to disk by the workflow
    # Team ID lives in the Appfile (not secret); allow an env override if set.
    team_id = ENV["APPLE_TEAM_ID"] ||
              CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # The workflow creates and unlocks a dedicated keychain (absolute path in
    # SIGNING_KEYCHAIN) and sets it as default, so the downloaded certificate
    # imports somewhere xcodebuild can actually find it.
    keychain_name = ENV.fetch("SIGNING_KEYCHAIN")
    keychain_password = ENV.fetch("SIGNING_KEYCHAIN_PASSWORD")

    # Monotonic build number from the CI run so TestFlight never rejects a dupe.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    # Apple caps the number of Distribution certificates. On ephemeral runners
    # each run would mint a brand-new one (the private key never persists), so we
    # hit that cap. Revoke the stale Distribution certs first — their private
    # keys are gone, so they can't sign anything, and revoking does NOT
    # invalidate builds already on TestFlight.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: key_id,
      issuer_id: issuer_id,
      filepath: File.expand_path(key_path)
    )
    Spaceship::ConnectAPI::Certificate.all.each do |cert|
      next unless cert.certificate_type.to_s.include?("DISTRIBUTION")

      UI.message("Revoking stale distribution certificate #{cert.id} (#{cert.certificate_type})")
      begin
        cert.delete!
      rescue StandardError => e
        UI.important("Could not revoke #{cert.id}: #{e.message}")
      end
    end

    # We deliberately use MANUAL signing instead of Xcode automatic/cloud
    # signing: on ephemeral CI runners automatic signing tries to provision an
    # "Apple Development" certificate tied to the machine and fails to
    # revoke/recreate it across runs. Instead we mint a Distribution certificate
    # and an App Store provisioning profile with the API key on each run.
    get_certificates(
      api_key: api_key,
      development: false,
      keychain_path: keychain_name,
      keychain_password: keychain_password
    )
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      development: false,
      force: true
    )

    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: team_id,
      targets: [SCHEME],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      }
    )

    # "What to Test" notes for this build, authored in the repo so every ship
    # carries a narrative for the tester. Optional — absent file = no changelog.
    notes_path = File.expand_path("testflight_notes.txt", __dir__)
    changelog = File.exist?(notes_path) ? File.read(notes_path).strip : nil

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      changelog: changelog,
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Build a signed release AAB and (if a Play service-account key is " \
       "configured) upload it to the Google Play internal track. Without the " \
       "key it just builds the artifact for the workflow to publish."
  lane :beta do
    # Build the App Bundle. Signing + versionCode come from env vars the workflow
    # exports (BLAHBLAH_UPLOAD_* + BLAHBLAH_VERSION_CODE), read in app/build.gradle.
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )

    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.message("Built AAB: #{aab}")

    json_key = ENV["PLAY_JSON_KEY_PATH"] # written to disk by the workflow if the secret exists
    unless json_key && File.exist?(json_key)
      UI.important("No Google Play service-account key configured " \
                   "(PLAY_JSON_KEY_PATH unset). Skipping upload — the signed AAB " \
                   "is still attached as a workflow artifact.")
      next
    end

    # Play requires release notes under metadata/android/<locale>/changelogs/.
    notes_path = File.expand_path("testflight_notes.txt", __dir__)
    if File.exist?(notes_path)
      changelog = File.read(notes_path).strip
      changelog_dir = File.expand_path("metadata/android/en-US/changelogs", __dir__)
      FileUtils.mkdir_p(changelog_dir)
      version_code = ENV["BLAHBLAH_VERSION_CODE"]
      File.write(File.join(changelog_dir, "#{version_code}.txt"), changelog) if version_code
      File.write(File.join(changelog_dir, "default.txt"), changelog)
    end

    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      track: "internal",
      aab: aab,
      json_key: json_key,
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
