default_platform(:ios)

APP_IDENTIFIER = "com.lightwave.blahblah".freeze
XCODEPROJ = "ios/BlahBlah.xcodeproj".freeze
WORKSPACE = "ios/BlahBlah.xcworkspace".freeze
SCHEME = "BlahBlah".freeze

platform :ios do
  desc "Build the iOS app and upload it to TestFlight (App Store Connect API key + cloud signing)"
  lane :beta do
    key_id = ENV.fetch("APPSTORE_API_KEY_ID")
    issuer_id = ENV.fetch("APPSTORE_ISSUER_ID")
    key_path = ENV.fetch("ASC_API_KEY_PATH") # .p8 written to disk by the workflow
    # Team ID lives in the Appfile (not secret); allow an env override if set.
    team_id = ENV["APPLE_TEAM_ID"] ||
              CredentialsManager::AppfileConfig.try_fetch_value(:team_id)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # Monotonic build number from the CI run so TestFlight never rejects a dupe.
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    # Cloud signing: Xcode creates/downloads the distribution certificate and
    # provisioning profile on the fly using the API key — no .p12 or
    # .mobileprovision needed.
    update_code_signing_settings(
      use_automatic_signing: true,
      path: XCODEPROJ,
      team_id: team_id,
      targets: [SCHEME]
    )

    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: auth,
      export_xcargs: auth,
      export_options: { signingStyle: "automatic" }
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end
end
